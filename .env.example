# Google Cloud OAuth 2.0 web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Firebase Admin service account JSON, supplied as a single-line JSON string.
# Do not use the Firebase browser configuration from firebase.md here.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=omnimail-central-app

# Optional local server settings
PORT=3000