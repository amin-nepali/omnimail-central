# Google Cloud OAuth 2.0 web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Path to a newly generated Firebase Admin service-account JSON file.
# Keep the file out of Git. Do not use a key that has been shared or exposed.
GOOGLE_APPLICATION_CREDENTIALS=./firebase-admin-service-account.json
# On Vercel, set FIREBASE_SERVICE_ACCOUNT_JSON to the replacement JSON value instead.
FIREBASE_PROJECT_ID=omnimail-central-app

# Optional local server settings
PORT=3000

# Required on public deployments to protect account and email routes.
APP_ACCESS_PASSWORD=
APP_SESSION_SECRET=